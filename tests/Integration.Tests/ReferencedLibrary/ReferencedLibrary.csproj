<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- netstandard2.0 pulls in the implicit NETStandard.Library package, which only a recursive scan reports -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <Version>2.0.0</Version>
  </PropertyGroup>

  <!-- Referenced by ProjectReferenceProject; does not import CycloneDX.MSBuild itself -->
  <ItemGroup>
    <PackageReference Include="Serilog" Version="4.4.0" />
  </ItemGroup>

</Project>
